# =============================================================================
# PrintPasa — environment configuration
# Copy to .env and fill in values. See docs/developers/configuration.md
# =============================================================================

# --- Core ---
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_DOCS_URL=https://printpasa-docs.pages.dev
NUXT_PUBLIC_DEMO_URL=https://printpasa-demo.pages.dev
NUXT_DEMO_MODE=false

# --- Auth (Better Auth) ---
NUXT_DISABLE_AUTH=false
NUXT_DISABLE_SIGNUP=false
NUXT_SESSION_PASSWORD=your-secret-min-32-characters-long-here
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_SUPERUSER_USERNAME=admin
NUXT_SUPERUSER_PASSWORD=

# --- Service token (automation / agents) ---
NUXT_SERVICE_TOKEN=
# NUXT_SERVICE_PROTECTED_PREFIXES=/api/workflow

# --- Database ---
TURSO_DATABASE_URL=file:./data/printpasa.db
TURSO_AUTH_TOKEN=

# --- Storage (S3-compatible) ---
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
NUXT_S3_BUCKET=your-bucket-name
NUXT_S3_REGION=us-east-2
# NUXT_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# --- AI providers (at least one required for pipeline) ---
NUXT_GEMINI_API_KEY=
NUXT_OPENAI_API_KEY=
NUXT_ANTHROPIC_API_KEY=
NUXT_XAI_API_KEY=
NUXT_GROQ_API_KEY=
NUXT_TOGETHER_API_KEY=
NUXT_DEEPINFRA_API_KEY=
NUXT_DEFAULT_AI_PROVIDER=gemini

# --- Image providers ---
NUXT_KREA_API_KEY=
NUXT_FAL_API_KEY=
NUXT_LEONARDO_API_KEY=
NUXT_REPLICATE_API_TOKEN=
NUXT_DEFAULT_IMAGE_PROVIDER=fal

# --- Optimization ---
NUXT_DEFAULT_UPSCALE_PROVIDER=local
NUXT_DEFAULT_BACKGROUND_REMOVAL_PROVIDER=local-bg
BACKGROUND_REMOVAL_PROVIDER=local-bg
PHOTOROOM_API_KEY=
NUXT_PHOTOROOM_API_KEY=

# --- Fulfillment (optional — stage 6–7) ---
NUXT_PRINTIFY_API_KEY=
NUXT_PRINTFUL_API_KEY=
NUXT_DEFAULT_FULFILLMENT_PROVIDER=printify

# --- Search & validation (optional) ---
NUXT_DEFAULT_SEARCH_PROVIDER=serper
NUXT_SERPER_API_KEY=
NUXT_SEARCHAPI_KEY=
NUXT_SERPAPI_KEY=
NUXT_RAPIDAPI_KEY=

# --- Reddit (optional Stage 1 trends) ---
NUXT_REDDIT_CLIENT_ID=
NUXT_REDDIT_CLIENT_SECRET=
NUXT_REDDIT_USER_AGENT=printpasa:1.0 (by /u/yourredditusername)

# --- SKU ---
NUXT_SKU_PREFIX=PP

# --- Telegram pipeline (optional) ---
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_WEBHOOK_SECRET=
NUXT_TELEGRAM_ALLOWED_CHAT_IDS=
NUXT_TELEGRAM_TOPIC_IDEA_GENERATION=
NUXT_TELEGRAM_TOPIC_DESIGN_REVIEW=
NUXT_PIPELINE_OWNER_USER_ID=admin
NUXT_PIPELINE_PARSE_IDEA_WITH_AI=false
CRON_TIMEZONE=UTC

# --- Deploy presets ---
# NITRO_PRESET=cloudflare_pages
